<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ublox_stick_tf</name>
  <version>1.0.0</version>
  <description>UTM/odom TF chain for stick GPS (pingdsp-style, transforms3d)</description>
  <maintainer email="your.email@example.com">Stick Team</maintainer>
  <license>BSD-3-Clause</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>geographic_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>python3-transforms3d</exec_depend>
  <exec_depend>python3-utm</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
