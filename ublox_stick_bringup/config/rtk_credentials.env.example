# Copy to rtk_credentials.env and fill in real credentials.
# rtk_credentials.env is gitignored — do not commit passwords.

# NTRIP caster (shared by all sticks)
NTRIP_HOST=nrtk-swepos.lm.se
NTRIP_PORT=80
NTRIP_MOUNTPOINT=MSM_GNSS

# Stick 1 RTK account
NTRIP_USERNAME_1=kth703
NTRIP_PASSWORD_1=your_password_here

# Stick 2 RTK account
NTRIP_USERNAME_2=kth705
NTRIP_PASSWORD_2=your_password_here

# Stick 3 RTK account
NTRIP_USERNAME_3=kth702
NTRIP_PASSWORD_3=your_password_here

# Stick 4 RTK account
NTRIP_USERNAME_4=kth706
NTRIP_PASSWORD_4=your_password_here

# Teensy box USB serials (needed when two boxes share one computer, and a good
# safety pin in general). Find each box's serial with:
#   ls /dev/serial/by-id/
#   -> usb-Teensyduino_Dual_Serial_<SERIAL>-if00 (LoLo) / -if02 (GNSS)
# TEENSY_USB_SERIAL_1=18013580
# TEENSY_USB_SERIAL_2=
# TEENSY_USB_SERIAL_3=
# TEENSY_USB_SERIAL_4=
